{
    "name": "always-open/serp-api",
    "description": "Package to integrate with SERP APIs",
    "keywords": [
        "always-open",
        "laravel",
        "serp-api",
        "serp"
    ],
    "homepage": "https://github.com/always-open/serp-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Quentin Schmick",
            "email": "qschmick@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.3.1|~8.4.1|~8.5.0",
        "always-open/laravel-request-logger": "^3.0|^4.0",
        "illuminate/contracts": "^12.0||^13.0",
        "spatie/laravel-data": "~4.16",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.6",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.3||^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AlwaysOpen\\SerpApi\\": "src/",
            "AlwaysOpen\\SerpApi\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlwaysOpen\\SerpApi\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlwaysOpen\\SerpApi\\SerpApiServiceProvider"
            ],
            "aliases": {
                "SerpApi": "AlwaysOpen\\SerpApi\\Facades\\SerpApi"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
